{
  "name": "kks-source-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only fixture-only Skybridge MCP App candidate for KKS public sources",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "predev": "node scripts/verify-readiness.mjs",
    "dev": "skybridge dev",
    "prebuild": "node scripts/verify-readiness.mjs",
    "build": "skybridge build",
    "prestart": "node scripts/verify-readiness.mjs",
    "start": "skybridge start",
    "test:fixture": "node --test tests/*.test.mjs",
    "test:runtime": "node scripts/test-runtime.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "skybridge": "2.0.3",
    "zod": "4.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "4.0.3"
    }
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "@skybridge/devtools": "2.0.0",
    "@skybridge/vite-plugin": "2.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "8.3.5",
    "typescript": "5.9.3",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
