{
  "schema_version": "1.1",
  "governance": {
    "policy": "KKS-PROJECT-CHAT-UNIFIED-SCOPE-R1",
    "git_policy": "KKS-AUTO-GIT-COMMIT-CRITICAL-APPROVAL-R1",
    "critical_action_approval": "fresh_action_specific",
    "write_strategy": "feature_branch_pull_request",
    "public_repository_boundary": true
  },
  "session_termination": {
    "status": "governance-gated",
    "timestamp": "2026-09-22T00:00:00Z",
    "reason": "Connector capability does not grant authorization",
    "connector_mode": "approval_required",
    "allow_autonomous_processing": false
  },
  "channel": {
    "name": "ChatGPT Connector Channel",
    "type": "api",
    "enabled": true,
    "permissions": {
      "read": true,
      "write": true,
      "delete": false,
      "admin": false
    },
    "authorization_note": "Effective permission is determined by the active connection, repository rules, and explicit approval.",
    "endpoints": {
      "base_url": "https://api.github.com/repos/RepoKan/K-Knowledgeable-",
      "store_md_file": "/contents",
      "retrieve_md_file": "/contents",
      "list_files": "/contents",
      "auth_type": "connection-managed"
    },
    "storage_config": {
      "default_directory": "chatgpt-generated",
      "file_format": "markdown",
      "auto_commit": false,
      "default_branch": "main",
      "write_target": "approved_feature_branch",
      "commit_message_template": "Scoped change: {filename}"
    }
  },
  "features": {
    "auto_file_creation": false,
    "version_control": true,
    "backup_enabled": false,
    "sync_enabled": true,
    "workflow_automation": false,
    "pull_request_required": true,
    "human_approval_required": true
  },
  "connector_processing": {
    "status": "governance-gated",
    "autonomous_mode": false,
    "processing_queue": [],
    "error_handling": "report_for_review",
    "max_retries": 0,
    "retry_delay_seconds": 0
  }
}
